{
  "name": "min",
  "version": "1.2.0",
  "private": true,
  "description": "Search, open, and organize your bookmark in a minimal new tab page.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm compile && wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "oxlint --deny correctness --deny perf",
    "lint:fix": "oxlint --fix",
    "lint:types": "wxt prepare && tsc -b",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm lint:types",
    "check:fix": "pnpm fmt && pnpm lint:fix",
    "release:check": "pnpm check && pnpm zip",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:push": "git push origin main && git push origin v$npm_package_version",
    "submit:chrome": "wxt submit --chrome-zip .output/min-$npm_package_version-chrome.zip",
    "submit:chrome:dry-run": "wxt submit --dry-run --chrome-zip .output/min-$npm_package_version-chrome.zip",
    "prepare": "wxt prepare",
    "dep:graph": "mkdir -p .analyzer/.dependency-graph && depcruise entrypoints/newtab --config scripts/dependency-cruiser.cjs --include-only '^entrypoints/newtab' --output-type dot | dot -T svg > .analyzer/.dependency-graph/dep-graph.svg",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.0",
    "@use-funnel/core": "^0.1.0",
    "es-toolkit": "^1.52.0",
    "ky": "^2.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylexjs/unplugin": "0.19.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.68.0",
    "typescript": "^5.9.3",
    "unplugin": "2.3.11",
    "vitest": "^5.0.0",
    "wxt": "^0.20.26"
  },
  "packageManager": "pnpm@10.27.0"
}
