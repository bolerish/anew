{
  "name": "min",
  "version": "1.0.0",
  "private": true,
  "description": "A cleaner way to search, open, and organize your Chrome bookmarks.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm compile && wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "oxlint --deny correctness --deny perf",
    "lint:fix": "oxlint --fix",
    "lint:types": "wxt prepare && tsc -b",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm lint:types",
    "check:fix": "pnpm fmt && pnpm lint:fix",
    "prepare": "wxt prepare",
    "dep:graph": "mkdir -p dependency-graph && depcruise entrypoints/newtab --config .dependency-cruiser.cjs --include-only '^entrypoints/newtab' --output-type dot | dot -T svg > dependency-graph/dep-graph.svg"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/react": "^0.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "es-toolkit": "^1.46.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^17.4.2",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wxt": "^0.20.25"
  }
}
