{
  "name": "min",
  "version": "1.1.0",
  "private": true,
  "description": "A cleaner way to search, open, and organize your Chrome bookmarks.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm compile && wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "oxlint --deny correctness --deny perf",
    "lint:fix": "oxlint --fix",
    "lint:types": "wxt prepare && tsc -b",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm lint:types",
    "check:fix": "pnpm fmt && pnpm lint:fix",
    "release:check": "pnpm check && pnpm zip",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:push": "git push origin main && git push origin v$npm_package_version",
    "submit:chrome": "wxt submit --chrome-zip .output/min-$npm_package_version-chrome.zip",
    "submit:chrome:dry-run": "wxt submit --dry-run --chrome-zip .output/min-$npm_package_version-chrome.zip",
    "prepare": "wxt prepare",
    "dep:graph": "mkdir -p dependency-graph && depcruise entrypoints/newtab --config scripts/dependency-cruiser.cjs --include-only '^entrypoints/newtab' --output-type dot | dot -T svg > dependency-graph/dep-graph.svg"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@base-ui/react": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "dependency-cruiser": "^17.4.3",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.68.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wxt": "^0.20.26"
  },
  "packageManager": "pnpm@10.27.0"
}
