{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "promise", "jsdoc", "vitest"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-unused-vars": "warn",
    "oxc/only-used-in-recursion": "warn"
  }
}
